{
  "name": "wisdom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run english:check",
    "build": "next build",
    "build:clean": "npm run clean:next && npm run build",
    "start": "next start",
    "lint": "eslint",
    "clean:next": "node scripts/clean-next-cache.mjs",
    "english:sync": "node scripts/sync-english-seeds.mjs",
    "english:check": "node scripts/check-english-coverage.mjs",
    "english:collect": "node scripts/collect-english-phrases.mjs",
    "english:promote": "node scripts/promote-english-candidates.mjs",
    "english:curate-priority": "node scripts/curate-english-priority.mjs",
    "english:curate-remaining": "node scripts/curate-english-remaining.mjs",
    "source-locales:check": "node scripts/check-source-locale-registry.mjs",
    "source-phrases:check": "node scripts/check-source-locale-phrase-seeds.mjs",
    "japanese:check": "node scripts/check-source-locale-phrase-seeds.mjs --locale=ja-JP",
    "japanese:collect": "node scripts/collect-source-locale-phrases.mjs --locale=ja-JP",
    "chinese:check": "node scripts/check-source-locale-phrase-seeds.mjs --locale=zh-CN",
    "chinese:collect": "node scripts/collect-source-locale-phrases.mjs --locale=zh-CN",
    "spanish:check": "node scripts/check-source-locale-phrase-seeds.mjs --locale=es-ES",
    "spanish:collect": "node scripts/collect-source-locale-phrases.mjs --locale=es-ES",
    "french:check": "node scripts/check-source-locale-phrase-seeds.mjs --locale=fr-FR",
    "french:collect": "node scripts/collect-source-locale-phrases.mjs --locale=fr-FR",
    "german:check": "node scripts/check-source-locale-phrase-seeds.mjs --locale=de-DE",
    "german:collect": "node scripts/collect-source-locale-phrases.mjs --locale=de-DE",
    "source-signals:build": "node scripts/build-source-locale-signals.mjs",
    "source-signals:check": "node scripts/check-source-locale-signals.mjs",
    "source-insights:check": "node scripts/check-source-locale-insights.mjs",
    "people:check": "node scripts/check-person-cultural-profiles.mjs",
    "content:quality": "node scripts/check-content-quality.mjs",
    "collect:worries": "node scripts/collect-worries.mjs",
    "clean:worries": "node scripts/clean-worries.mjs",
    "content:backlog": "node scripts/build-content-backlog.mjs",
    "content:organize": "node scripts/clean-worries.mjs && node scripts/build-content-backlog.mjs && npm run english:sync && npm run english:check",
    "content:refresh": "node scripts/collect-worries.mjs && node scripts/clean-worries.mjs && node scripts/build-content-backlog.mjs && npm run english:sync && npm run english:check"
  },
  "dependencies": {
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4"
  }
}
